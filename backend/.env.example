# Local SQLite is the default.
DATABASE_URL=sqlite:///./local_kb.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=10485760
MIN_RETRIEVAL_SCORE=0.04

# Keep empty to use extractive fallback; never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# auto tries LaBSE if sentence-transformers is installed; hashing is lightweight/offline.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/LaBSE

# Set only for private single-user deployments; enter in UI at runtime, not in Vite variables.
APP_API_KEY=
MAX_DOCUMENT_CHARS=200000
