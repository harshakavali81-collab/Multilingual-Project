# COPY to .env; replace every required value. Never commit .env.
DB_USER=postgres
DB_NAME=multilingual_kb
# Use URL-safe alphanumeric characters for connection-string interpolation.
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_20_PLUS_CHARACTER_PASSWORD
WEB_BIND=127.0.0.1
EMBEDDING_BACKEND=hashing
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_CHARS=200000
