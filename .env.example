# Copy to .env for Docker Compose. Change the database password for local deployments.
DB_USER=postgres
DB_PASSWORD=change-this-local-password
DB_NAME=multilingual_kb
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/LaBSE
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
MAX_UPLOAD_BYTES=10485760

# Set only for private single-user deployments; enter in UI at runtime, not in Vite variables.
APP_API_KEY=
MAX_DOCUMENT_CHARS=200000

# Leave AUTH_REQUIRED=false for local testing. Production Compose forces true.
AUTH_REQUIRED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
