# Optional. With no key, the backend returns source excerpts instead of generated answers.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional. Requires installing backend/requirements-ai.txt or extending the Docker image.
# Supports Indian-language cross-lingual semantic retrieval (model downloaded on first use).
EMBEDDING_MODEL=
# Example: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
