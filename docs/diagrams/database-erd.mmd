    datetime locked_until
    datetime created_at
  }
  LOGIN_SESSIONS {
    integer id PK
    integer user_id FK
    varchar token_hash UK
    datetime expires_at
  }
  DOCUMENTS {
    integer id PK
    integer owner_id FK
    varchar title
    text content
    varchar language
    varchar category
    datetime created_at
  }
  CHAT_HISTORY {
    integer id PK
    integer owner_id FK
    text question
    text answer
    varchar language
    text sources_json
    varchar answer_mode
    datetime created_at
  }
