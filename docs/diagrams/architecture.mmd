flowchart LR
  User["Browser user"] --> UI["Nginx-served React UI"]
  UI --> Auth["FastAPI auth middleware"]
  Auth -->|Login| Session["Argon2 passwords and hashed session tokens"]
  Auth -->|Authorized workspace| API["FastAPI routes"]
  Session --> Users[("Auth users and sessions")]
  API --> Owner["Owner-scoped SQL queries"]
  Owner --> DB[("PostgreSQL documents and history")]
  API --> Retrieval["LaBSE optional or hashing fallback"]
  Retrieval --> LLM{"Groq key configured?"}
  LLM -->|Yes| Generation["Grounded LLM answer"]
  LLM -->|No| Fallback["Extractive source answer"]
  Generation --> DB
  Fallback --> DB
  DB --> Graphs["Real analytics graphs"]
  Graphs --> UI
